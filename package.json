{
  "name": "xqq-clash",
  "version": "1.4.1",
  "description": "XQQ Clash - Clash YAML 配置生成器（测速/搜索/批量操作/规则管理/节点备份）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage deb",
    "start:web": "node web-server.js",
    "test:server": "node _test-server.js",
    "test:smoke": "electron smoke.js"
  },
  "author": {
    "name": "XQQ",
    "email": "xqq@example.com"
  },
  "homepage": "https://github.com/xqq/xqq-clash",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.xqq.clash",
    "productName": "XQQ Clash",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "XQQClash-${version}-Portable.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Utility",
      "artifactName": "XQQClash-${version}-${os}-${arch}.${ext}"
    }
  }
}
